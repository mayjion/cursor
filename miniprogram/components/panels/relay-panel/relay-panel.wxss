/* 整体背景 */
page {
  background: #4463a0;
}

/* 最外层容器 */
.relay-container {
  padding: 40rpx 24rpx 40rpx 24rpx;
  box-sizing: border-box;
}

/* 卡片 */
.card {
  width: 100%;
  box-sizing: border-box;

  background: #e4dcdc;
  border-radius: 28rpx;
  padding: 36rpx;
  margin-bottom: 18rpx;

  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.04);
}

/* 卡片头部 */
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.title {
  font-size: 38rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

/* 状态文字 */
.status {
  margin-top: 24rpx;
  font-size: 30rpx;
}

.status.on {
  color: #16c06e;
  font-weight: 500;
}

.status.off {
  color: #999;
}

/* ================= 定时区域 ================= */

.schedule-card {
  padding-top: 40rpx;
}

.schedule-card .card-title {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 36rpx;
}

/* 表单项 */
.form-item {
  display: flex;
  justify-content: space-between;
  align-items: center;

  padding: 28rpx 0;
  border-bottom: 1px solid #f0f0f0;

  font-size: 30rpx;
}

.value {
  color: #333;
  font-weight: 500;
}

/* 保存按钮 */
.save-btn {
  margin-top: 50rpx;
  height: 88rpx;
  line-height: 88rpx;

  background: #16c06e;
  border-radius: 44rpx;

  font-size: 32rpx;
  font-weight: 600;

  box-shadow: 0 8rpx 20rpx rgba(22, 192, 110, 0.25);
}

/* ================= 星期选择 ================= */

.week-select {
  margin: 30rpx 0;
}

.week-title {
  font-size: 28rpx;
  margin-bottom: 20rpx;
  color: #666;
}

.week-row {
  display: flex;
  justify-content: space-between;
}

.week-item {
  flex: 1;
  margin: 0 6rpx;

  height: 74rpx;
  border-radius: 50%;

  background: #f3f4f6;

  text-align: center;
  line-height: 74rpx;
  font-size: 28rpx;

  transition: all 0.2s ease;
}

.week-item.active {
  background: #16c06e;
  color: #fff;
  box-shadow: 0 6rpx 16rpx rgba(22, 192, 110, 0.3);
}

/* ================= 继电器选择 ================= */

.relay-select {
  margin: 30rpx 0;
}

.relay-row {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.relay-item {
  padding: 18rpx 32rpx;
  border-radius: 40rpx;

  background: #f3f4f6;
  font-size: 28rpx;

  transition: all 0.2s ease;
}

.relay-item.active {
  background: #16c06e;
  color: #fff;
  box-shadow: 0 6rpx 16rpx rgba(22, 192, 110, 0.25);
}
.task-item {
  padding: 16rpx 0;
  font-size: 28rpx;
  border-bottom: 1px solid #f2f2f2;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  padding: 20rpx 0;
}

.enter-tip {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #16c06e;
  text-align: right;
}
