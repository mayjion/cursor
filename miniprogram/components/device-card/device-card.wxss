/* ==============================
   卡片整体
================================ */
.card {
  width: 100%;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(0,0,0,0.06);
  overflow: hidden;
  position: relative;
  display: flex;
  flex-direction: column;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.card:active {
  transform: scale(0.98);
  box-shadow: 0 6rpx 18rpx rgba(0,0,0,0.05);
}

/* ==============================
   图片区域
================================ */
.image-container {
  width: 100%;
  height: 0;
  padding-top: 40%;           
  position: relative;
  background: linear-gradient(135deg, #ffffff, #ffffff);
  overflow: hidden;
}

.cover {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;             /* 更有质感 */
  transition: transform 0.4s ease;
}

.card:hover .cover {
  transform: scale(1.05);
}

/* ==============================
   右上角开关
================================ */
.switch-container {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  z-index: 10;

  padding: 6rpx 12rpx;
  border-radius: 40rpx;

  background: rgba(255,255,255,0.75);
  backdrop-filter: blur(10rpx);
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.08);
}

/* ==============================
   信息区
================================ */
.info {
  flex: 1;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}


.status-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 24rpx;
  margin-top: 12rpx;
}


/* 在线状态 */
.status {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.status::before {
  content: '';
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}

.online::before {
  background: #4caf50;
  box-shadow: 0 0 8rpx rgba(76,175,80,0.6);
}

.offline::before {
  background: #c4c4c4;
}

.online { 
  color: #4caf50; 
  font-weight: 600; 
}

.offline { 
  color: #999; 
}

/* 协议文字 */
.protocol {
  color: #999;
  font-size: 22rpx;
}

/* ==============================
   右下角更多按钮
================================ */
.more-btn {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;

  width: 56rpx;
  height: 56rpx;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 50%;

  background: rgba(0,0,0,0.04);
  transition: background 0.2s ease;
}

.more-btn:active {
  background: rgba(0,0,0,0.1);
}
/* 标题 + 开关横向排列 */
.title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}
