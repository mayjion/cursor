/* pages/index/index.wxss */

/* 页面整体容器 */
.page-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #77c3fa 0%, #1894fa 100%);
  padding-bottom: 140rpx; /* 留出底部空间，避免被遮挡 */
}

/* 设备列表容器 */
.device-list-container {
  padding: 0 20rpx;
}

.device-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 32rpx 24rpx;
  margin: 40rpx 20rpx 60rpx;  /* 底部多留点空间 */
  padding: 0;
}

.device-card {
  /* 移除 height: 300rpx; 让子组件自己决定高度 */
  border-radius: 24rpx;
  overflow: hidden;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.08);
}

.device-card:hover {
  transform: translateY(-4rpx);
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.12);
}

/* 图片区域 - 改成正方形，更适合设备图标 */
.device-card .image-container {
  width: 100%;
  height: 0;
  padding-top: 100%;                /* 1:1 正方形，设备图标最常见比例 */
  position: relative;
  background: #f0f5ff;              /* 浅蓝背景作为加载中/失败占位 */
  flex-shrink: 0;                   /* 防止被压缩 */
}

.device-card .cover {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;                /* 填满并裁剪 */
  object-position: center;
}

/* 信息区域 - 占满剩余高度 */
.device-card .info {
  flex: 1;                          /* 关键：撑满 */
  padding: 20rpx 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

/* 标题 - 支持最多两行 */
.device-card .title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-bottom: 8rpx;
}

/* 状态行 - 更紧凑、对齐更好 */
.device-card .status-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 26rpx;
  color: #666;
}

/* 开关和更多按钮位置微调 */
.device-card .switch-container {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  z-index: 2;
}

.device-card .more-btn {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  z-index: 2;
}

/* 无设备提示 */
.no-device {
  text-align: center;
  padding: 200rpx 0;
  color: #666;
  font-size: 32rpx;
}