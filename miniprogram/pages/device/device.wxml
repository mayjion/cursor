<view class="container">

<!-- 加载中 -->
<view wx:if="{{loading}}" class="state-view">
  加载中...
</view>

<!-- 错误 -->
<view wx:elif="{{error}}" class="state-view">
  {{error}}
</view>

<!-- 正常内容 -->
<view wx:elif="{{device}}">

  <view class="device-header">
    <view class="device-name">
      {{device.alias || device.deviceName || '未知设备'}}
    </view>

    <view class="device-meta">
      <text class="{{device.online ? 'status-online' : 'status-offline'}}">
        {{device.online ? '在线' : '离线'}}
      </text>

      <text>
        {{device.connectType ? device.connectType.toUpperCase() : ''}}
      </text>
    </view>
  </view>

<view class="panel-card">

  <relay-panel
    wx:if="{{device.capabilities}}"
    device="{{device}}"
  />

</view>

</view>

</view>
