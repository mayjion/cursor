page {
  background: #f5f6f8;
}

/* 外层容器 */
.container {
  padding: 20rpx 24rpx 40rpx 24rpx;
  box-sizing: border-box;
}

/* 加载/错误 */
.state-view {
  padding: 60rpx 0;
  text-align: center;
  font-size: 30rpx;
  color: #999;
}

/* 顶部设备信息卡片 */
.device-header {
  background: #ffffff;
  border-radius: 32rpx;
  padding: 48rpx 40rpx;
  margin-bottom: 30rpx;

  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04);
}

.device-name {
  font-size: 44rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
  letter-spacing: 1rpx;
}

.device-meta {
  display: flex;
  justify-content: space-between;
  font-size: 30rpx;
  color: #666;
}

.status-online {
  color: #16c06e;
  font-weight: 500;
}

.status-offline {
  color: #999;
}
/* 控制面板卡片 */
.panel-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 120rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 12rpx 30rpx rgba(0, 0, 0, 0.05);
}
